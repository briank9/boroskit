# BorosKit: turns compiled SPIR-V files into a C++ source file with one uint32_t array each (cmake -P script).
# Original BorosKit code written for this project; contains no third-party code.
# Written 2026-11-26 by agent "vulkan-engine" (step M6). Our own few lines instead of a third-party embed tool.
#
# Use: cmake -DOUTPUT=<file.cpp> -DSPIRV_FILES=<a.spv;b.spv> -P cmake/BKEmbedSpirv.cmake
# Each shader is named after its file stem without the stage extension: bk_mesh_vertex.vert.spv -> "bk_mesh_vertex".

set(body "// GENERATED by cmake/BKEmbedSpirv.cmake from the GLSL in Sources/BorosKitGPUVulkan/Shaders - do not edit.\n")
string(APPEND body "// BorosKit's own compiled shaders (glslc + spirv-val at build time, user decision D1).\n")
string(APPEND body "#include \"BKVulkanShaderTable.h\"\n\nnamespace boroskit { namespace gpu { namespace vk {\n\n")
set(table "")
set(count 0)
foreach(spv IN LISTS SPIRV_FILES)
    get_filename_component(file "${spv}" NAME)
    string(REGEX REPLACE "\\.[a-z]+\\.spv$" "" stem "${file}")
    file(READ "${spv}" hex HEX)
    string(LENGTH "${hex}" chars)
    math(EXPR words "${chars} / 8")
    # little-endian bytes b0 b1 b2 b3 -> word 0xb3b2b1b0
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," words_text "${hex}")
    string(APPEND body "static const uint32_t k_${stem}[${words}] = {${words_text}};\n")
    string(APPEND table "    { \"${stem}\", k_${stem}, ${words} },\n")
    math(EXPR count "${count} + 1")
endforeach()
string(APPEND body "\nconst EmbeddedShader kEmbeddedShaders[] = {\n${table}};\nconst size_t kEmbeddedShaderCount = ${count};\n\n}}}  // namespace\n")
file(WRITE "${OUTPUT}" "${body}")
